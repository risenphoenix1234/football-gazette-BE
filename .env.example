PORT=4000

# Comma-separated list of origins allowed to call this API
# e.g. http://localhost:3000,https://thefootballgazette.com
CORS_ORIGIN=http://localhost:3000

# Simple shared-secret auth for the admin dashboard.
# Swap this for real user auth (JWT/sessions) before going to production.
ADMIN_API_KEY=change-me-to-a-long-random-string
